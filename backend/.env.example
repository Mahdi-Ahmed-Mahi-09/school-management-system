# Copy to .env and adjust. Never commit the real .env file.

# development | production
APP_ENV=development
PORT=8080

# PostgreSQL connection (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/classora?sslmode=disable

# Secret used to sign session tokens. Required, at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Session lifetime without / with "Keep me signed in"
JWT_TTL=12h
JWT_REMEMBER_TTL=168h

# School timezone (IANA name) used for "today" and "this month" on the dashboard
APP_TIMEZONE=Asia/Dhaka

# ISO 4217 currency used to display teacher salaries
SALARY_CURRENCY=BDT

# Browser origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session cookie. SESSION_COOKIE_SECURE defaults to true in production.
# SESSION_COOKIE_NAME=classora_session
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_DOMAIN=

# Apply pending migrations on startup (defaults to true outside production)
# AUTO_MIGRATE=true

# bcrypt work factor (10-15)
# BCRYPT_COST=12

# Login attempts allowed per client IP per window
# LOGIN_RATE_LIMIT=10
# LOGIN_RATE_WINDOW=15m
